---
layout: layouts/base.njk
bodyClass: blog-page article-page
---
{% block schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ title }}",
  "description": "{{ description }}",
  "image": "{{ image | default('https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=1200&q=80') }}",
  "datePublished": "{{ datePublished | default(date) }}",
  "dateModified": "{{ dateModified | default(datePublished) | default(date) }}",
  "author": {
    "@type": "Organization",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}"
  },
  "publisher": {
    "@type": "Organization",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}",
    "logo": {
      "@type": "ImageObject",
      "url": "{{ site.logo }}"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ site.url }}{{ page.url }}"
  }
}
</script>
{% endblock %}

<main class="article-content">
  <article class="article">
    {{ content | safe }}
  </article>
</main>
