---
layout: layouts/thank-you.njk
title: Thank You
permalink: /thank-you.html
---
<div class="shell">
  <div class="body">
    <div class="content" style="padding-top:40px">
      <div class="content-inner" style="text-align:center">
        <div class="h1" style="margin-bottom:12px">Thank you!</div>
        <div class="section-sub" style="margin-bottom:24px">
          Hi <span id="userName">there</span>! We've received your information and a tax specialist will contact you within 24 hours.
        </div>

        <div style="background:var(--light-gray);padding:20px;border-radius:8px;margin-bottom:24px;text-align:left">
          <h3 style="margin:0 0 12px 0;color:var(--ink)">What happens next:</h3>
          <div style="display:flex;align-items:center;margin-bottom:8px">
            <span style="background:var(--brand);color:white;border-radius:50%;width:20px;height:20px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:bold;margin-right:12px">1</span>
            <span>We'll review your tax situation</span>
          </div>
          <div style="display:flex;align-items:center;margin-bottom:8px">
            <span style="background:var(--brand);color:white;border-radius:50%;width:20px;height:20px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:bold;margin-right:12px">2</span>
            <span>Determine the best resolution strategy</span>
          </div>
          <div style="display:flex;align-items:center">
            <span style="background:var(--brand);color:white;border-radius:50%;width:20px;height:20px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:bold;margin-right:12px">3</span>
            <span>Create a personalized action plan</span>
          </div>
        </div>

        <div style="background:var(--gold-soft);border:1px solid var(--gold-muted);padding:16px;border-radius:8px;margin-bottom:24px">
          <div style="font-weight:600;color:var(--ink);margin-bottom:8px">While you wait:</div>
          <div style="font-size:14px;color:var(--muted)">
            Gather your tax documents and don't worry about IRS notices. Call us if you receive any urgent communications.
          </div>
        </div>

        <a href="{{ '/' | url }}" class="btn primary" style="margin-bottom:16px">Return to Homepage</a>

        <div style="font-size:14px;color:var(--muted)">
          Need help? Call us at <strong id="buyerPhone" data-phone>(555) TAX-PEACE</strong>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const session = JSON.parse(localStorage.getItem('tpn_session') || '{}');
  if (session.buyer_phone) {
    document.querySelectorAll('[data-phone]').forEach(el => {
      el.textContent = session.buyer_phone;
    });
  }
</script>
