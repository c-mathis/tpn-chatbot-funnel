          <ul>
            <li>Based on ability to pay</li>
            <li>Requires IRS approval</li>
            <li>Not everyone qualifies</li>
          </ul>
        </a>
        <a href="{{ '/services/currently-not-collectible' | url }}" class="option-card" style="text-decoration: none; color: inherit;">
